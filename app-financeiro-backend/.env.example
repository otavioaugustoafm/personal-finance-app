# Copie para .env (nunca commite o .env)

# String de conexao do Neon. Em Lambda, prefira o endpoint "pooled" (host com -pooler).
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Segredo para assinar o JWT (minimo 32 caracteres). Gere com: python scripts/gerar_credenciais.py
JWT_SECRET_KEY=

# Hash bcrypt da senha de acesso. Gere com: python scripts/gerar_credenciais.py
# Use aspas simples, pois o hash contem "$".
APP_PASSWORD_HASH=''

# Origens permitidas no CORS, separadas por virgula (sem barra final)
ALLOWED_ORIGINS=http://localhost:5173

# --- Sincronizacao com o Meu Pluggy (Fase 2) ---
# Credenciais da aplicacao em dashboard.pluggy.ai > Applications
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# itemId de cada banco conectado (copie em Applications > Demo > Connected Items). Varios: separe por virgula.
PLUGGY_ITEM_IDS=
